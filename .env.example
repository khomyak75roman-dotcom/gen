# ===========================================
# Video Generator v4.0 Configuration
# Копіюйте цей файл у .env та редагуйте
# ===========================================

# --- Мова та голоси ---
DEFAULT_LANGUAGE=uk-UA
DEFAULT_VOICE=uk-UA-NataShaNeural
# Доступні мови: uk-UA, en-US, pl-PL, ru-RU, de-DE, fr-FR, es-ES
# Повний список голосів: https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support?tabs=tts

# --- Роздільна здатність відео ---
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
# Рекомендовані значення: 1920x1080, 1280x720, 2560x1440

# --- Шляхи ---
OUTPUT_DIR=./output
TEMP_DIR=./temp
# Відносні або абсолютні шляхи

# --- API ключі (опціонально) ---
# Stability AI для генерації зображень
AI_IMAGE_API_KEY=

# --- Логування ---
LOG_LEVEL=INFO
# Доступні рівні: DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- GUI налаштування ---
THEME=System
# Доступні теми: Light, Dark, System
SCALING=1.0
# Масштаб інтерфейсу (0.8 - 1.2)
